# Local development settings; this template contains no personal IDs or credentials.
# Copy to .env. Runtime values will be supplied as container environment variables.
GENAI_AUTH_MODE=api_key
GENAI_REGION=eu-frankfurt-1
GENAI_PROJECT_ID=replace-with-your-generative-ai-project-ocid
GENAI_MODEL=replace-with-a-model-already-tested-with-MCP
GENAI_API_KEY=replace-with-your-generative-ai-api-key

FUSION_BASE_URL=https://replace-with-your-fusion-host
FUSION_USERNAME=replace-with-your-fusion-username
# Optional during setup. Required for live Fusion tests unless supplied in the UI.
FUSION_PASSWORD=
# Optional; normally derived from FUSION_BASE_URL.
FUSION_SCOPE=
FUSION_WORKFLOW=replace-with-your-published-workflow-code


# Deployment/operator settings, not runtime authentication credentials.
OCI_REGION=eu-frankfurt-1
OCI_CLI_PROFILE=DEFAULT
OCI_COMPARTMENT_NAME=replace-with-your-compartment-name
OCI_COMPARTMENT_ID=replace-with-your-compartment-ocid
OCIR_TENANCY_NAMESPACE=replace-with-your-registry-namespace
OCIR_USERNAME=replace-with-your-registry-username
OCIR_REPOSITORY=agents/fusionmcp
OCI_HOSTED_APPLICATION_NAME=FusionMCP
OCI_HOSTED_DEPLOYMENT_NAME=fusionmcp-0-1-0
# Filled after your own deployment.
OCI_HOSTED_APPLICATION_ID=
MCP_SERVER_URL=

# Generated by your own hosted deployment. No credentials belong in the URL.
DEMO_URL=
OCI_HOSTED_DEPLOYMENT_ID=
